# PatchPilot configuration — copy to .env and fill in.
# Every variable is optional; the defaults run a local SQLite + local-sandbox setup.

# ---- model provider ---------------------------------------------------------
# One of: anthropic | openai | scripted   ("scripted" is a test double, not for real runs)
PATCHPILOT_PROVIDER=anthropic
PATCHPILOT_MODEL=claude-sonnet-5

# Keys are read from PATCHPILOT_* first, then from the vendor's standard variable.
# NEVER commit a real key.
PATCHPILOT_ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY=

# PATCHPILOT_PROVIDER=openai
# PATCHPILOT_MODEL=gpt-4.1
# PATCHPILOT_OPENAI_API_KEY=

# ---- persistence ------------------------------------------------------------
# SQLite by default. Swap this single line for Postgres:
# PATCHPILOT_DATABASE_URL=postgresql+asyncpg://patchpilot:patchpilot@localhost:5432/patchpilot
# PATCHPILOT_DATABASE_URL=sqlite+aiosqlite:///./data/patchpilot.db

# ---- agent budgets ----------------------------------------------------------
PATCHPILOT_MAX_ITERATIONS=30
PATCHPILOT_MAX_TOOL_CALLS=160
PATCHPILOT_MAX_RUNTIME_S=1800
PATCHPILOT_MAX_TEST_RUNTIME_S=600
PATCHPILOT_MAX_COST_USD=5.0

# ---- sandbox ----------------------------------------------------------------
# local  = subprocess with cwd jail, env allow-list, timeouts and output caps
# docker = one container per run, --network none, cpu/memory/pid limits
PATCHPILOT_SANDBOX=local
# The docker sandbox runs with --network none, so nothing can be installed at
# run time: the image must already contain git, a test runner, and the
# repository's dependencies. Build the bundled one with `make docker-image`.
PATCHPILOT_DOCKER_IMAGE=patchpilot/runner:latest
PATCHPILOT_DOCKER_MEMORY=2g
PATCHPILOT_DOCKER_CPUS=2

# ---- MCP --------------------------------------------------------------------
PATCHPILOT_MCP_ENABLED=false
PATCHPILOT_MCP_CONFIG_PATH=./mcp.config.json

# Tool permission policy (comma separated). Deny always wins over allow.
# PATCHPILOT_TOOL_ALLOW=list_files,read_file,search_code,find_symbol,apply_patch,edit_file,write_file,git_diff,git_status,git_log,run_tests,run_command,record_hypothesis,finish
# PATCHPILOT_TOOL_DENY=git_push,git_commit,delete_repository,host_shell,credential_access,network_fetch

# ---- SWE-bench --------------------------------------------------------------
PATCHPILOT_SWEBENCH_DATASET=princeton-nlp/SWE-bench_Lite
PATCHPILOT_SWEBENCH_SPLIT=test
PATCHPILOT_SWEBENCH_MAX_WORKERS=4

# ---- api --------------------------------------------------------------------
PATCHPILOT_API_HOST=127.0.0.1
PATCHPILOT_API_PORT=8000
PATCHPILOT_LOG_LEVEL=INFO
